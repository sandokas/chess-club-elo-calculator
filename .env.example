NODE_ENV=development

# Database
POSTGRES_DB=chess_club
POSTGRES_USER=chess_club
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# When running via docker compose, host is `postgres` (service name), not localhost
DATABASE_URL=postgres://chess_club:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/chess_club

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173

# Authentication & Session
# 32+ chars, random. Used to hash session tokens.
SESSION_COOKIE_SECRET=your-secret-key-min-32-chars

# Google OAuth - create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI in Google Console MUST match OAUTH_REDIRECT_URL exactly.
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/google/callback

# Web app base URL (used for post-login redirects)
WEB_BASE_URL=http://localhost:5173

# CORS (comma-separated origins). In dev, web and api share origin via Vite proxy
# so this is only enforced when NODE_ENV != development.
ALLOWED_ORIGINS=http://localhost:5173

# Feature flag: enforce auth on protected routes. Set false to allow anonymous access in dev.
REQUIRE_AUTH=false

# Bootstrap: first user logging in with this email is auto-promoted to owner of all existing clubs.
# Leave blank to disable.
BOOTSTRAP_OWNER_EMAIL=
