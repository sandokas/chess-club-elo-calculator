NODE_ENV=development

# Target PostgreSQL database. This is where imported data will be written.
IMPORT_TARGET_DATABASE_URL=postgres://chess_club:chess_club@localhost:5432/chess_club

# Source SQLite database copied from the legacy Python application.
IMPORT_SQLITE_PATH=./chessclub.db

# Club/admin bootstrap records created or reused during import.
IMPORT_INITIAL_ADMIN_EMAIL=admin@example.com
IMPORT_INITIAL_ADMIN_NAME=Initial Admin
IMPORT_INITIAL_CLUB_NAME=Imported Chess Club
IMPORT_INITIAL_CLUB_SLUG=imported-chess-club

# Optional. Defaults to ./configs/business_config.json when present.
# IMPORT_BUSINESS_CONFIG_PATH=./configs/business_config.json
