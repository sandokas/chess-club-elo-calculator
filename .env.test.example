NODE_ENV=test

# Test database — separate DB on the same Postgres instance so tests cannot
# pollute dev data. Use `localhost` so this works from the Windows/macOS host.
# Run `pnpm --filter @chess-club/db db:migrate:test` once to create + migrate.
DATABASE_URL=postgres://chess_club:chess_club_dev_password@localhost:5432/chess_club_test

# Anything else can be left blank or copied from .env.example. The test setup
# falls back to .env for any key not defined here.
SESSION_COOKIE_SECRET=test-session-secret-must-be-at-least-32-chars-long
