# Disable pnpm's "verify deps before run" auto-installer.
#
# In dev, the Docker compose setup bind-mounts the source tree into the
# container while masking node_modules with anonymous volumes (so each
# environment has its own platform-correct install). pnpm's deps-status
# check then sees the bind-mounted package.json/lockfile alongside the
# image-installed node_modules and decides they're "out of sync", which
# triggers an attempted reinstall that fails on permissions and is
# unnecessary anyway because the image already installed everything at
# build time.
#
# Disabling this also makes host script runs faster and avoids surprise
# reinstalls. Run `pnpm install` explicitly when you intend to install.
verify-deps-before-run=false
