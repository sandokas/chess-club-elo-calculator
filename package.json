{
  "name": "chess-club-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "scripts": {
    "dev": "pnpm --parallel --filter @chess-club/api --filter @chess-club/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @chess-club/db db:generate",
    "db:migrate": "pnpm --filter @chess-club/db db:migrate",
    "import:sqlite": "pnpm --filter @chess-club/db import:sqlite",
    "docker:up": "docker compose up --build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
